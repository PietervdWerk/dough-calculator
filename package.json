{
  "name": "dough-calculator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler pages deploy dist/client --project-name dough-calculator --branch main",
    "deploy:preview": "pnpm build && wrangler pages deploy dist/client --project-name dough-calculator --branch preview"
  },
  "dependencies": {
