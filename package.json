    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.133.21",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.12",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}